#!/bin/bash
# dtq ワーカー本体。launchd から常駐起動される。
#
#   スイープ → 処理 → 待機 を回す。検知の本命は定期スイープで、
#   fswatch は入っていれば待機を早く切り上げるだけ（§05）。
#
# set -e は使わない。常駐デーモンなので単発の失敗で死なせず、
# エラーは各所で明示的に扱う。
set -uo pipefail

DTQ_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$DTQ_HOME/lib/dtq-common.sh"

STOPPING=0
MODE="loop"
CURRENT_CHILD=""   # 実行中の子プロセス。停止指示のときここへ SIGTERM を送る

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# BSD date は +%z が "+0900" になる。ISO 8601 の "+09:00" に整える。
iso_now() { date '+%Y-%m-%dT%H:%M:%S%z' | sed 's/\(..\)$/:\1/'; }

field() { "$DTQ_PY" "$DTQ_EMIT" field "$1" "$2" 2>/dev/null; }

# SIGTERM を受けてから最大1秒で抜けられるよう、細切れに待つ。
interruptible_sleep() {
  local total="$1" i=0
  while [ "$i" -lt "$total" ]; do
    [ "$STOPPING" = "1" ] && return 0
    sleep 1
    i=$((i + 1))
  done
}

# ---------------------------------------------------------------- 取り込み

# 取り込み待ちの管理。
#
# 当初は「何回持ち越したか」で打ち切っていたが、これは誤りだった。fswatch は
# iCloud のダウンロード進行中に何度も発火するため、スイープが 9〜11秒間隔で
# 回り、40秒でリトライ上限を使い切ってしまう。実測では iPhone から置いた4件が
# すべて、中身が届く前に failed へ落ちた。
# 経過時間で判断すれば、スイープが何回走ろうと結果は変わらない。
seen_key() { printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '_'; }

# 初めて見た時刻からの経過秒。未記録なら今を記録して 0 を返す。
seen_age() {
  local sf now first
  sf="$TRIES_DIR/$(seen_key "$1").seen"
  now=$(date +%s)
  if [ -f "$sf" ]; then
    first=$(cat "$sf" 2>/dev/null)
  else
    first="$now"
    printf '%s' "$now" > "$sf"
  fi
  [ -n "$first" ] || first="$now"
  echo $((now - first))
}

clear_seen() {
  local k; k="$(seen_key "$1")"
  rm -f "$TRIES_DIR/$k.seen" "$TRIES_DIR/$k.logged" 2>/dev/null
}

# 同じ理由をスイープのたびに書くとログが溢れるので 30 秒に1回へ間引く。
log_waiting() {
  local base="$1" reason="$2" age="$3" lf now last
  lf="$TRIES_DIR/$(seen_key "$base").logged"
  now=$(date +%s)
  last=$(cat "$lf" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge 30 ]; then
    printf '%s' "$now" > "$lf"
    log "取り込み待ち ${age}秒: $base — $reason"
  fi
}

# まだ取り込めない状態。期限を過ぎたら failed へ送る。
# $4 に期限（秒）を渡す。JSON の構文エラーは実体が揃えば直らないので短く、
# 同期待ちは長く取る。
not_ready() {
  local f="$1" base="$2" reason="$3" deadline="$4" age
  age="$(seen_age "$base")"
  if [ "$age" -ge "$deadline" ]; then
    log "ERROR: ${age}秒たっても取り込めない: $base — $reason"
    clear_seen "$base"
    reject "$f" "$base" "not_ready" "$reason（${age}秒待機して打ち切り）"
  else
    log_waiting "$base" "$reason" "$age"
  fi
}

# 中身が JSON のつもりか（先頭の非空白が { か [ ）。
# iOS ショートカットは JSON を書いても .txt として保存することがあるため、
# 拡張子ではなく中身で判断する必要がある。
looks_like_json() {
  local c
  c="$(head -c 512 "$1" 2>/dev/null | tr -d '[:space:]' | head -c 1)"
  [ "$c" = "{" ] || [ "$c" = "[" ]
}

# iCloud にまだ実体が無いか（dataless）。
# 注意: dataless でもサイズは本来の値を返すので、大きさでは判別できない。
is_dataless() {
  local fl
  fl="$(stat -f '%f' "$1" 2>/dev/null)" || return 1
  [ $((fl & 1073741824)) -ne 0 ]   # SF_DATALESS = 0x40000000
}

# 検証に落ちた投入ファイルを failed/ に送る。元ファイルも併置する（§07）。
reject() {
  local src="$1" name="$2" kind="$3" msg="$4" stamp target
  stamp="$(date '+%Y%m%d-%H%M%S')"
  target="$FAILED_DIR/${stamp}_${name}"
  mv "$src" "$target" 2>/dev/null || cp "$src" "$target" 2>/dev/null
  "$DTQ_PY" "$DTQ_EMIT" json \
    status=failed \
    stage=validation \
    source="$name" \
    error_kind="$kind" \
    message="$msg" \
    failed_at="$(iso_now)" \
    saved_as="$(basename "$target")" \
    > "$FAILED_DIR/${stamp}_${name}.error.json" 2>/dev/null
  log_event event=job_failed stage=validation source="$name" error_kind="$kind" message="$msg"
}

# queue/ の1ファイルをローカルへ抜き、ジョブに展開する。
intake() {
  local f="$1" base sha8 mtime dest out rc kind msg created skipped
  base="$(basename "$f")"

  # JSON はパースできるまで取り込まない。壊れて見えるのは同期途中の
  # 可能性があるので、期限まで持ち越す（§05）。
  # 拡張子ではなく中身で判断する。ショートカットが JSON を .txt として
  # 保存してくることがあるため。
  if [ "$(lower "${base##*.}")" = "json" ] || looks_like_json "$f"; then
    if ! jq empty "$f" >/dev/null 2>&1; then
      not_ready "$f" "$base" "JSON として解析できない（同期途中の可能性）" "$PARSE_DEADLINE"
      return 0
    fi
  fi

  sha8="$(shasum -a 256 "$f" 2>/dev/null | cut -c1-8)"
  mtime="$(stat -f '%m' "$f" 2>/dev/null)"
  if [ -z "$sha8" ] || [ -z "$mtime" ]; then
    log "ERROR: メタデータを読めない: $base"
    return 0
  fi
  dest="$INCOMING_DIR/$sha8-$mtime-$base"

  # iCloud から抜く。以降このファイルについて iCloud には触らない（§03）。
  #
  # iPhone から同期された直後は、内容が揃っていても iCloud のファイルプロバイダが
  # まだ掴んでいて rename が弾かれることがある。実測では1回失敗し、次のスイープ
  # （59秒後）で成功した。恒久的な失敗と区別するため、上限まで持ち越す。
  local mv_err
  if ! mv_err="$(mv "$f" "$dest" 2>&1)"; then
    # iCloud のファイルプロバイダがまだ掴んでいると rename が
    # "Resource deadlock avoided" で弾かれる。実体が届けば通る。
    not_ready "$f" "$base" "ローカルへ移せない: ${mv_err:-理由不明}" "$INTAKE_DEADLINE"
    return 0
  fi
  clear_seen "$base"

  out="$("$DTQ_PY" "$DTQ_PARSE" \
          --src "$dest" --src-name "$base" \
          --sha8 "$sha8" --mtime "$mtime" \
          --outdir "$PENDING_DIR" --ledger "$LEDGER_DIR")"
  rc=$?

  if [ "$rc" -ne 0 ]; then
    kind="$(printf '%s' "$out" | jq -r '.error_kind // empty' 2>/dev/null)"
    msg="$(printf '%s' "$out" | jq -r '.message // empty' 2>/dev/null)"
    [ -n "$kind" ] || kind="parse_error"
    [ -n "$msg" ] || msg="$out"
    log "検証エラー [$kind] $base — $msg"
    clear_seen "$base"
    reject "$dest" "$base" "$kind" "$msg"
    return 0
  fi

  created="$(printf '%s' "$out" | jq -r '.created | length' 2>/dev/null || echo 0)"
  skipped="$(printf '%s' "$out" | jq -r '.skipped | length' 2>/dev/null || echo 0)"
  clear_seen "$base"
  log "取り込み: $base → ${created}件を投入、${skipped}件は実行済みのためスキップ"
  log_event event=intake source="$base" created:="${created:-0}" skipped:="${skipped:-0}"

  mv "$dest" "$ARCHIVE_DIR/" 2>/dev/null
}

# キューが読めるかを確かめる。
#
# launchd 配下のプロセスは、署名済み app バンドルを経由しないと iCloud Drive
# （~/Library/Mobile Documents）を読めない。TCC に阻まれると [ -d ] は通るのに
# ls が Operation not permitted になり、glob が空を返す。つまり「権限がない」と
# 「1件も来ていない」が区別できないまま黙って素通りしてしまう。必ず明示的に確かめる。
QUEUE_WARNED_AT=0
queue_readable() {
  local now
  if ls "$Q_DIR" >/dev/null 2>&1; then
    if [ "$QUEUE_WARNED_AT" != "0" ]; then
      log "キューを読めるようになった: $Q_DIR"
      QUEUE_WARNED_AT=0
    fi
    return 0
  fi
  # 60秒ごとに同じ警告を出し続けないよう、30分に1回だけ記録する。
  now=$(date +%s)
  if [ $((now - QUEUE_WARNED_AT)) -gt 1800 ]; then
    QUEUE_WARNED_AT=$now
    log "ERROR: キューを読めない: $Q_DIR"
    log "       iCloud アクセスの確認ダイアログを未承認か、署名済み app バンドルを"
    log "       経由せず起動している。素のスクリプトはダイアログすら出ず拒否される。"
    log "       確認: launchctl print gui/$(id -u)/local.drawthings.queue | grep program"
    log "       → DrawThingsQueue.app/Contents/MacOS/... を指していなければ dtq-setup を再実行"
    log_event event=queue_unreadable path="$Q_DIR"
  fi
  return 1
}

sweep_queue() {
  [ -d "$Q_DIR" ] || return 0
  queue_readable || return 0

  # プレースホルダが残っていれば実体化を促す（§05）。
  if ls "$Q_DIR"/.*.icloud >/dev/null 2>&1; then
    log "iCloud プレースホルダを検出 → brctl download"
    brctl download "$Q_DIR" >/dev/null 2>&1
  fi

  local list f base sig sig2 sz
  list="$TMP_DIR/sweep.$$"
  : > "$list"

  for f in "$Q_DIR"/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in .*) continue ;; esac
    case "$(lower "$base")" in
      *.txt|*.json) ;;
      *) continue ;;
    esac

    # iCloud に実体がまだ無いものには触らない。ここを見落とすと、
    # 中身が空のまま処理してしまう（実測: 空ファイルの SHA を job_id に
    # 使ってしまい、rename も "Resource deadlock avoided" で弾かれた）。
    if is_dataless "$f"; then
      brctl download "$f" >/dev/null 2>&1
      not_ready "$f" "$base" "iCloud からダウンロード中" "$INTAKE_DEADLINE"
      continue
    fi

    sz="$(stat -f '%z' "$f" 2>/dev/null)" || continue
    if [ "$sz" -eq 0 ]; then
      not_ready "$f" "$base" "中身がまだ空" "$INTAKE_DEADLINE"
      continue
    fi

    sig="$(stat -f '%z:%m' "$f" 2>/dev/null)" || continue
    printf '%s\t%s\n' "$sig" "$f" >> "$list"
  done

  if [ ! -s "$list" ]; then
    rm -f "$list"
    return 0
  fi

  # サイズと mtime が動かなければ安定とみなす（§05）。
  interruptible_sleep "$STABLE_WAIT"

  while IFS="$(printf '\t')" read -r sig f; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    sig2="$(stat -f '%z:%m' "$f" 2>/dev/null)" || continue
    if [ "$sig" != "$sig2" ]; then
      not_ready "$f" "$base" "まだ書き込みが続いている" "$INTAKE_DEADLINE"
      continue
    fi
    intake "$f"
  done < "$list"

  rm -f "$list"
}

# ---------------------------------------------------------------- 実行

finish_job() {
  # 台帳に記録して、ジョブ定義を保管する。成功・失敗どちらでも通る。
  local jf="$1" job_id="$2"
  : > "$LEDGER_DIR/$job_id"
  mv "$jf" "$ARCHIVE_DIR/$job_id.job.json" 2>/dev/null || rm -f "$jf"
}

run_job() {
  local jf="$1"
  local job_id title prompt_len neg seed steps width height cfg
  local started ended t0 t1 dur rc attempt stamp out errlog manifest imgjson
  local pfile nfile g thumb ekind

  job_id="$(field "$jf" job_id)"
  title="$(field "$jf" title)"
  seed="$(field "$jf" seed)"
  steps="$(field "$jf" steps)"
  width="$(field "$jf" width)"
  height="$(field "$jf" height)"
  neg="$(field "$jf" negative_prompt)"
  cfg="$("$DTQ_PY" "$DTQ_EMIT" config "$jf" 2>/dev/null)"

  if [ -z "$job_id" ] || [ -z "$title" ] || [ -z "$seed" ]; then
    log "ERROR: ジョブ定義が壊れている: $(basename "$jf")"
    mv "$jf" "$FAILED_DIR/" 2>/dev/null || rm -f "$jf"
    return 0
  fi

  # §06: プロンプトは必ずファイル経由。引用符・改行・シェル特殊文字を
  #      含んでいても壊れず、シェル展開もされない。
  pfile="$TMP_DIR/$job_id.prompt.txt"
  "$DTQ_PY" "$DTQ_EMIT" field "$jf" prompt > "$pfile"
  nfile=""
  if [ -n "$neg" ]; then
    nfile="$TMP_DIR/$job_id.negative.txt"
    "$DTQ_PY" "$DTQ_EMIT" field "$jf" negative_prompt > "$nfile"
  fi

  if [ ! -f "$MODELS_DIR/$DT_MODEL" ]; then
    log "ERROR: モデルがローカルに無い: $MODELS_DIR/$DT_MODEL"
    log "       dtq-setup を実行して取り込んでください"
    "$DTQ_PY" "$DTQ_EMIT" compose "$jf" \
      status=failed stage=preflight error_kind=models_missing \
      message="モデルがローカルに複製されていない。dtq-setup を実行する" \
      failed_at="$(iso_now)" \
      > "$FAILED_DIR/$job_id.error.json" 2>/dev/null
    cp "$jf" "$FAILED_DIR/$job_id.job.json" 2>/dev/null
    log_event event=job_failed stage=preflight job_id="$job_id" error_kind=models_missing
    rm -f "$pfile" "$nfile" 2>/dev/null
    finish_job "$jf" "$job_id"
    return 0
  fi

  stamp="$(date '+%Y%m%d-%H%M%S')"
  out="$IMAGES_DIR/${title}_${seed}_${stamp}.png"
  errlog="$TMP_DIR/$job_id.err"

  # 引数は配列で組み立てる。eval は使わない（§06）。
  local -a cmd
  cmd=( "$DT_CLI" generate
        --models-dir "$MODELS_DIR"
        --model "$DT_MODEL"
        --prompt-file "$pfile"
        --steps "$steps"
        --seed "$seed"
        --no-download-missing
        --disable-preview
        -o "$out" )
  [ -n "$nfile" ]  && cmd=( "${cmd[@]}" --negative-prompt-file "$nfile" )
  [ -n "$width" ]  && cmd=( "${cmd[@]}" --width "$width" --height "$height" )
  [ -n "$cfg" ]    && cmd=( "${cmd[@]}" --config-json "$cfg" )

  started="$(iso_now)"
  t0=$(date +%s)
  rc=0

  while :; do
    attempt="$("$DTQ_PY" "$DTQ_EMIT" bump "$jf")"
    log "generate 開始 [$job_id] attempt=$attempt seed=$seed steps=$steps"
    log_event event=generate_start job_id="$job_id" attempt:="$attempt" seed:="$seed"
    : > "$errlog"
    run_with_timeout "$GEN_TIMEOUT" "${cmd[@]}" >> "$errlog" 2>&1
    rc=$?
    [ "$rc" -eq 0 ] && break
    if [ "$rc" -eq 124 ]; then
      log "タイムアウト(${GEN_TIMEOUT}s) [$job_id]"
    else
      log "generate 失敗 rc=$rc [$job_id]"
    fi
    if [ "$attempt" -ge "$MAX_ATTEMPTS" ] || [ "$STOPPING" = "1" ]; then
      break
    fi
    log "${RETRY_WAIT}s 後に再試行 [$job_id]"
    interruptible_sleep "$RETRY_WAIT"
  done

  t1=$(date +%s)
  dur=$((t1 - t0))
  ended="$(iso_now)"

  # 停止指示による中断は失敗ではない。ジョブ定義を running/ に残したまま抜け、
  # 次回起動時のリカバリ（§08）で再実行させる。試行回数も戻しておく。
  if [ "$STOPPING" = "1" ] && [ "$rc" -ne 0 ]; then
    "$DTQ_PY" "$DTQ_EMIT" bump "$jf" -1 >/dev/null 2>&1
    log "停止指示により中断 [$job_id]（次回起動時に再実行する）"
    log_event event=job_interrupted job_id="$job_id"
    rm -f "$pfile" "$nfile" "$errlog" 2>/dev/null
    return 0
  fi

  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 124 ] && ekind="timeout" || ekind="generate_failed"
    log "FAILED [$job_id] $ekind rc=$rc ${dur}s"
    "$DTQ_PY" "$DTQ_EMIT" compose "$jf" \
      status=failed \
      stage=generate \
      error_kind="$ekind" \
      exit_code:="$rc" \
      stderr_tail="$(tail -c 2000 "$errlog" 2>/dev/null)" \
      started_at="$started" \
      finished_at="$ended" \
      duration_sec:="$dur" \
      > "$FAILED_DIR/$job_id.error.json" 2>/dev/null
    # 元のジョブ定義も併置して、iPhone から直して置き直せるようにする（§07）。
    cp "$jf" "$FAILED_DIR/$job_id.job.json" 2>/dev/null
    log_event event=job_failed stage=generate job_id="$job_id" error_kind="$ekind" \
              exit_code:="$rc" duration_sec:="$dur"
    rm -f "$pfile" "$nfile" "$errlog" 2>/dev/null
    finish_job "$jf" "$job_id"
    return 0
  fi

  # batch>1 のとき CLI が -0000 / -0001 を付けるので、両方の形を拾う。
  manifest="$TMP_DIR/$job_id.manifest"
  imgjson="$TMP_DIR/$job_id.images.json"
  : > "$manifest"
  for g in "${out%.png}"*.png; do
    [ -f "$g" ] || continue
    thumb="$THUMBS_DIR/$(basename "${g%.png}").jpg"
    if sips -Z 512 -s format jpeg -s formatOptions 70 "$g" --out "$thumb" >/dev/null 2>&1; then
      printf '%s\t%s\n' "$g" "thumbs/$(basename "$thumb")" >> "$manifest"
    else
      log "WARN: サムネイル生成に失敗: $(basename "$g")"
      printf '%s\t\n' "$g" >> "$manifest"
    fi
  done

  "$DTQ_PY" "$DTQ_EMIT" images < "$manifest" > "$imgjson"

  "$DTQ_PY" "$DTQ_EMIT" compose "$jf" \
    status=success \
    "images:@$imgjson" \
    started_at="$started" \
    finished_at="$ended" \
    duration_sec:="$dur" \
    > "$RESULTS_DIR/$job_id.result.json" 2>/dev/null

  log "OK [$job_id] ${dur}s $(wc -l < "$manifest" | tr -d ' ')枚 → $(basename "$out")"
  # 成功していても異常に遅い場合は記録する。TCC の許可ダイアログ待ちで
  # ブロックされていた場合、結果は成功なのでこれが唯一の手がかりになる。
  if [ "$dur" -gt "$SLOW_GEN_WARN" ]; then
    log "WARN [$job_id] 生成に ${dur}s かかった（通常は90〜110s）。"
    log "     許可ダイアログでブロックされた可能性がある。ログを確認:"
    log "     log show --last 30m --predicate 'subsystem == \"com.apple.TCC\"' | grep -i drawthingsqueue"
    log_event event=slow_generation job_id="$job_id" duration_sec:="$dur"
  fi
  log_event event=job_success job_id="$job_id" duration_sec:="$dur" \
            images:="$(wc -l < "$manifest" | tr -d ' ')" output="$out"

  rm -f "$pfile" "$nfile" "$errlog" "$manifest" "$imgjson" 2>/dev/null
  finish_job "$jf" "$job_id"
}

process_pending() {
  local job base swept=0
  while :; do
    [ "$STOPPING" = "1" ] && return 0
    # ジョブとジョブの間でもキューを見る。
    #
    # ここを回さないと、バッチ処理中はスイープが一切走らない。実測では
    # 8件（13分半）の処理中にキューが放置され、壊れた JSON の打ち切りが
    # 期限180秒に対して818秒かかった。20件溜まった状態なら、その間に置いた
    # ファイルは30〜80分検知されないことになり、「検知遅延は最大60秒」
    # （§12）を満たせない。
    # 呼び出し元が直前にスイープ済みなので、2周目以降だけ回す。
    if [ "$swept" = "1" ]; then
      sweep_queue
    fi
    swept=1
    job="$(ls -1 "$PENDING_DIR"/*.job.json 2>/dev/null | head -1)"
    [ -n "$job" ] || return 0
    base="$(basename "$job")"
    # running/ に移してから実行する。ここに残っていれば中断されたと分かる（§08）。
    mv "$job" "$RUNNING_DIR/$base" 2>/dev/null || continue
    run_job "$RUNNING_DIR/$base"
  done
}

# ---------------------------------------------------------------- 保守

# §08: 前回クラッシュ時に running/ に取り残されたジョブを回収する。
recover_running() {
  local f base attempts job_id
  for f in "$RUNNING_DIR"/*.job.json; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    job_id="$(field "$f" job_id)"
    attempts="$(field "$f" attempts)"
    [ -n "$attempts" ] || attempts=0
    if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
      log "リカバリ: 試行上限に達していたので failed へ: $base"
      "$DTQ_PY" "$DTQ_EMIT" compose "$f" \
        status=failed stage=recovery error_kind=interrupted \
        message="ワーカー中断後、試行上限に達していたため打ち切り" \
        failed_at="$(iso_now)" \
        > "$FAILED_DIR/${job_id:-$base}.error.json" 2>/dev/null
      cp "$f" "$FAILED_DIR/${job_id:-$base}.job.json" 2>/dev/null
      log_event event=job_failed stage=recovery job_id="$job_id" error_kind=interrupted
      finish_job "$f" "${job_id:-$base}"
    else
      log "リカバリ: 中断ジョブを再投入: $base (attempts=$attempts)"
      mv "$f" "$PENDING_DIR/$base" 2>/dev/null
    fi
  done
}

# §07: thumbs/ と results/ だけ保持期間で掃除する。画像原本と archive/ は消さない。
cleanup_old() {
  find "$THUMBS_DIR" "$RESULTS_DIR" -maxdepth 1 -type f -mtime "+${RETENTION_DAYS}" -delete 2>/dev/null
  find "$TMP_DIR" -maxdepth 1 -type f -mtime +1 -delete 2>/dev/null
}

wait_for_change() {
  if command -v fswatch >/dev/null 2>&1; then
    # イベントが来れば即座に、来なければスイープ間隔で切り上げる。
    run_with_timeout "$SWEEP_INTERVAL" fswatch -1 --latency 3 -- "$Q_DIR" >/dev/null 2>&1
  else
    interruptible_sleep "$SWEEP_INTERVAL"
  fi
}

# ---------------------------------------------------------------- 起動

on_term() {
  STOPPING=1
  # 生成中なら draw-things-cli も止める。放っておくと GPU を掴んだまま
  # 孤児として残り、次に起動したワーカーと競合する。
  [ -n "$CURRENT_CHILD" ] && terminate_group "$CURRENT_CHILD" TERM
  return 0
}

run() {
  trap on_term TERM INT

  if [ ! -x "$DT_CLI" ]; then
    log "FATAL: draw-things-cli が見つからない: $DT_CLI"
    exit 1
  fi
  if command -v fswatch >/dev/null 2>&1; then
    log "worker 起動 pid=$$ 検知=スイープ${SWEEP_INTERVAL}s + fswatch"
  else
    log "worker 起動 pid=$$ 検知=スイープ${SWEEP_INTERVAL}s のみ（fswatch 未導入）"
  fi

  recover_running

  local last_cleanup=0 now
  while :; do
    rotate_logs
    sweep_queue
    process_pending

    now=$(date +%s)
    if [ $((now - last_cleanup)) -gt "$CLEANUP_INTERVAL" ]; then
      cleanup_old
      last_cleanup=$now
    fi

    [ "$MODE" = "once" ] && break
    [ "$STOPPING" = "1" ] && break
    wait_for_change
    [ "$STOPPING" = "1" ] && break
  done

  log "worker 停止"
}

case "${1:-}" in
  --once) MODE="once" ;;
  "")     MODE="loop" ;;
  *)      echo "使い方: $(basename "$0") [--once]" >&2; exit 64 ;;
esac

ensure_dirs || exit 1

# ロックはワーカー自身が持つ。lockf を親プロセスにする方式は採らない。
# lockf は SIGTERM を子に転送しないため、launchd の停止指示で lockf だけが
# 死に、ワーカーが孤児として走り続けたままロックが解放される。そこへ
# launchd が再起動をかけると2本が同時に走り「直列1本」（§06）が壊れる。
if ! acquire_lock; then
  log "他のワーカーが動作中のため終了する"
  exit 0
fi
trap release_lock EXIT

run
